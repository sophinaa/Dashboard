# ---- AI (server-side only; never prefix with NEXT_PUBLIC_) ----
# Anthropic API key. If unset, the AI panel shows "AI unavailable" – no scripted fallback is used.
ANTHROPIC_API_KEY=
# Model used for explanations (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high (default: medium)
ANTHROPIC_EFFORT=medium

# ---- Study defaults (used until a researcher saves a configuration) ----
# Dataset: A or B
STUDY_DEFAULT_DATASET=A
# AI condition: on or off
STUDY_DEFAULT_AI=on
# Participant mode hides researcher controls: on or off
STUDY_DEFAULT_PARTICIPANT_MODE=off

# Optional access code for the researcher setup page (/researcher).
# Leave empty for no code (acceptable for a local, supervised session).
RESEARCHER_ACCESS_CODE=
